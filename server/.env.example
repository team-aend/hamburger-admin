PORT=4100
NODE_ENV=development

# 사용자 서버와 같은 Supabase PostgreSQL (Session Pooler 주소)
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# 관리자 화면 주소. 쓰기 요청의 Origin 검사에 쓴다. (개발: Vite 5173)
ADMIN_PUBLIC_ORIGIN=http://localhost:5173

# 관리자 세션 쿠키 서명용 (32자 이상). 사용자 서버의 SESSION_SECRET 과 다른 값을 쓴다.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# 이미지 업로드 (Supabase Storage). 서비스 키는 서버에만 둔다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=catalog
