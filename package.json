{
  "name": "hamburger-admin",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,WEB\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=web\"",
    "dev:mock": "npm run dev:mock --workspace=web",
    "build": "npm run build --workspace=server && npm run build --workspace=web",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
